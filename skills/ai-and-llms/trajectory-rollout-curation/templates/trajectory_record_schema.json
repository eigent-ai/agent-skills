{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "RecordedAgentTrajectory", "type": "object", "required": ["artifact_type", "trajectory_id", "task_id", "group_id", "policy_name", "example_seed", "s_out", "s_proc", "composite_reward", "group_advantage", "invalid_moves", "messages", "token_segments"], "properties": {"artifact_type": {"type": "string", "const": "recorded_trajectory", "description": "Explicitly distinguishes recorded trajectories from task_dataset, supervised_training_example, and online RL policy updates."}, "trajectory_id": {"type": "string"}, "task_id": {"type": "string"}, "group_id": {"type": "string"}, "policy_name": {"type": "string"}, "example_seed": {"type": "integer"}, "difficulty_bucket": {"type": "string"}, "s_out": {"type": "integer", "enum": [0, 1]}, "s_proc": {"type": "number", "minimum": 0.0, "maximum": 1.0}, "composite_reward": {"type": "number"}, "group_advantage": {"type": "number"}, "invalid_moves": {"type": "integer", "minimum": 0}, "termination_reason": {"type": "string"}, "messages": {"type": "array", "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"type": "string", "enum": ["system", "user", "assistant"]}, "content": {"type": "string"}}}}, "token_segments": {"type": "array", "items": {"type": "object", "required": ["turn", "role", "token_count", "loss_mask", "token_ids_sha256"], "properties": {"turn": {"type": "integer"}, "role": {"type": "string"}, "token_count": {"type": "integer"}, "loss_mask": {"type": "integer", "enum": [0, 1]}, "token_ids_sha256": {"type": "string"}}}}}}